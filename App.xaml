<Application x:Class="BlueDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0: shared, theme independent -->
                <ResourceDictionary Source="Themes/Shared.xaml" />
                <!-- Index 1: palette (colours, light or dark), swapped by ThemeService -->
                <ResourceDictionary Source="Themes/Fluent.Light.xaml" />
                <!-- Index 2: theme structure (templates, radii), swapped by ThemeService -->
                <ResourceDictionary Source="Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
