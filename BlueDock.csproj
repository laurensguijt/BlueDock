<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 = Windows 10 2004: minimum for the WinRT Bluetooth/Radio APIs used here -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BlueDock</RootNamespace>
    <AssemblyName>BlueDock</AssemblyName>
    <ApplicationIcon>Assets\bluedock.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Release builds get the version from the tag; this is the fallback for local builds -->
    <Version>0.1.8</Version>
    <Product>BlueDock</Product>
    <Authors>Laurens Guijt</Authors>
    <!-- Lets the project also compile on non-Windows build machines (CI) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\bluedock.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project sits in a subfolder, which the SDK would otherwise glob into this one -->
    <Compile Remove="Tests\**" />
    <Page Remove="Tests\**" />
    <Resource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>


  <ItemGroup>
    <!-- The grouping, category and update checks are internal on purpose: they are
         implementation detail, but they are also exactly what went wrong before. -->
    <InternalsVisibleTo Include="BlueDock.Tests" />
  </ItemGroup>

</Project>
