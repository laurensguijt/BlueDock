<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 = Windows 10 2004: minimum for the WinRT Bluetooth/Radio APIs used here -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BlueDock</RootNamespace>
    <AssemblyName>BlueDock</AssemblyName>
    <ApplicationIcon>Assets\bluedock.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>BlueDock</Product>
    <Authors>Laurens Guijt</Authors>
    <!-- Lets the project also compile on non-Windows build machines (CI) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\bluedock.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Toasts: an unpackaged app needs an application user model id plus a COM activator
         registered under HKCU\Software\Classes before Windows accepts a notification. This
         package performs that registration; calling the WinRT API directly fails with
         ERROR_NOT_FOUND (0x80070490). -->
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
  </ItemGroup>

</Project>
