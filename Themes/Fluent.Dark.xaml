<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ Fluent palette: Dark ============
         Colours only. The structure of this theme (templates, radii, spacing) lives in
         Fluent.xaml; ThemeService merges a palette and a structure together. Both palettes
         of a theme must define exactly the same keys.

         Values follow the Windows 11 dark palette, so the panel sits naturally on dark Mica. -->

    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#00000000" />
    <SolidColorBrush x:Key="Brush.WindowFallback" Color="#FF202020" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFC7C7C7" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF000000" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="Brush.Link" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="Brush.Badge" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="Brush.BadgeForeground" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="Brush.IconButton" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="Brush.IconButtonBorder" Color="#00FFFFFF" />
    <!-- Windows 11 dark uses a light accent fill with dark text on top -->
    <SolidColorBrush x:Key="Brush.PrimaryBackground" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="Brush.PrimaryForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="Brush.PrimaryBorder" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="Brush.SwitchOff" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Brush.SwitchBorder" Color="#FF9C9C9C" />
    <SolidColorBrush x:Key="Brush.SwitchThumbOff" Color="#FFCFCFCF" />
    <SolidColorBrush x:Key="Brush.SwitchOn" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="Brush.SwitchThumbOn" Color="#FF000000" />
    <SolidColorBrush x:Key="Brush.ControlBackground" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Brush.PopupBackground" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="Brush.PopupText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.PopupSelected" Color="#2660CDFF" />
    <SolidColorBrush x:Key="Brush.PopupHover" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="Brush.SettingsCard" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Brush.SettingsCardBorder" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Card" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Brush.DeviceButton" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.DeviceButtonBorder" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="Brush.DeviceButtonForeground" Color="#FFFFFFFF" />

</ResourceDictionary>
