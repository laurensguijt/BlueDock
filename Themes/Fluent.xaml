<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:c="clr-namespace:BlueDock.Controls">

    <!-- ============ Theme: Windows 11 Fluent (Mica, light) ============ -->

    <sys:String x:Key="Theme.Backdrop">Mica</sys:String>
    <FontFamily x:Key="Font.Main">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Thickness x:Key="Thickness.WindowPadding">12,12,12,12</Thickness>
    <Thickness x:Key="Thickness.SectionHeader">8,14,0,6</Thickness>

    <CornerRadius x:Key="Radius.Badge">6</CornerRadius>

    <CornerRadius x:Key="Radius.IconButton">4</CornerRadius>
    <CornerRadius x:Key="Radius.Button">4</CornerRadius>
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Card">6</CornerRadius>

    <ItemsPanelTemplate x:Key="Panel.Connected"><StackPanel /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Panel.Paired"><StackPanel /></ItemsPanelTemplate>

    <DataTemplate x:Key="Template.ConnectedItem">
        <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                CornerRadius="6" Padding="12,10" Margin="0,0,0,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:TablerIcon Data="{Binding Icon}" IconSize="20" Margin="2,0,14,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                            Visibility="{Binding HasBattery, Converter={x:Static c:Conv.BoolToVis}}">
                    <Grid Width="24" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Border BorderBrush="{DynamicResource Brush.TextSecondary}" BorderThickness="1" CornerRadius="2.5" />
                        <Border x:Name="Fill" Background="{DynamicResource Brush.Text}" CornerRadius="1" Margin="2" HorizontalAlignment="Left"
                                Width="{Binding BatteryValue, Converter={x:Static c:Conv.PercentToWidth}, ConverterParameter=20}" />
                    </Grid>
                    <TextBlock x:Name="Pct" Text="{Binding BatteryText}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                </StackPanel>
                <Button Grid.Column="3" Style="{DynamicResource Style.DeviceButton}" Margin="10,0,0,0"
                        VerticalAlignment="Center" Content="{Binding ActionText}"
                        Command="{Binding ToggleConnectionCommand}"
                        Visibility="{Binding CanToggle, Converter={x:Static c:Conv.BoolToVis}}"
                        ToolTip="Disconnect this device"
                        AutomationProperties.Name="Disconnect" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.Warning}" />
                <Setter TargetName="Pct" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Template.PairedItem">
        <Button Style="{DynamicResource Style.CardButton}" Command="{Binding ToggleConnectionCommand}"
                ToolTip="Click to connect" AutomationProperties.Name="Connect">
    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,10" Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:TablerIcon Data="{Binding Icon}" IconSize="20" Margin="2,0,14,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Button>
        <DataTemplate.Triggers>
            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>