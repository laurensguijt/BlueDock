<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:c="clr-namespace:BlueDock.Controls">

    <!-- ============ Theme: Windows 11 Fluent (Mica, light) ============ -->

    <sys:String x:Key="Theme.Backdrop">Mica</sys:String>
    <sys:Boolean x:Key="Theme.IsDark">False</sys:Boolean>
    <FontFamily x:Key="Font.Main">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Window -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="Brush.WindowFallback" Color="#FFF3F3F3" />
    <Thickness x:Key="Thickness.WindowPadding">12,12,12,12</Thickness>
    <Thickness x:Key="Thickness.SectionHeader">8,14,0,6</Thickness>

    <!-- Text and accents -->
    <SolidColorBrush x:Key="Brush.Text" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF5C5C5C" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF005FB8" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="Brush.Link" Color="#FF005FB8" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#0F000000" />

    <!-- Header badge -->
    <SolidColorBrush x:Key="Brush.Badge" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="Brush.BadgeForeground" Color="#FF005FB8" />
    <CornerRadius x:Key="Radius.Badge">6</CornerRadius>

    <!-- Buttons -->
    <SolidColorBrush x:Key="Brush.IconButton" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="Brush.IconButtonBorder" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="Brush.PrimaryBackground" Color="#FF005FB8" />
    <SolidColorBrush x:Key="Brush.PrimaryForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.PrimaryBorder" Color="#FF005FB8" />
    <CornerRadius x:Key="Radius.IconButton">4</CornerRadius>
    <CornerRadius x:Key="Radius.Button">4</CornerRadius>
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Card">6</CornerRadius>

    <!-- Switch -->
    <SolidColorBrush x:Key="Brush.SwitchOff" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="Brush.SwitchBorder" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="Brush.SwitchThumbOff" Color="#FF5C5C5C" />
    <SolidColorBrush x:Key="Brush.SwitchOn" Color="#FF005FB8" />
    <SolidColorBrush x:Key="Brush.SwitchThumbOn" Color="#FFFFFFFF" />

    <!-- Dropdown and settings -->
    <SolidColorBrush x:Key="Brush.ControlBackground" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#1F000000" />
    <SolidColorBrush x:Key="Brush.PopupBackground" Color="#FFF9F9F9" />
    <SolidColorBrush x:Key="Brush.PopupText" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="Brush.PopupSelected" Color="#1A005FB8" />
    <SolidColorBrush x:Key="Brush.PopupHover" Color="#0F000000" />
    <SolidColorBrush x:Key="Brush.SettingsCard" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="Brush.SettingsCardBorder" Color="#14000000" />

    <!-- Device cards -->
    <SolidColorBrush x:Key="Brush.Card" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#14000000" />

    <ItemsPanelTemplate x:Key="Panel.Connected"><StackPanel /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Panel.Paired"><StackPanel /></ItemsPanelTemplate>

    <DataTemplate x:Key="Template.ConnectedItem">
        <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                CornerRadius="6" Padding="12,10" Margin="0,0,0,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="20" Margin="2,0,14,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                            Visibility="{Binding HasBattery, Converter={x:Static c:Conv.BoolToVis}}">
                    <Grid Width="24" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Border BorderBrush="{DynamicResource Brush.TextSecondary}" BorderThickness="1" CornerRadius="2.5" />
                        <Border x:Name="Fill" Background="{DynamicResource Brush.Text}" CornerRadius="1" Margin="2" HorizontalAlignment="Left"
                                Width="{Binding BatteryValue, Converter={x:Static c:Conv.PercentToWidth}, ConverterParameter=20}" />
                    </Grid>
                    <TextBlock x:Name="Pct" Text="{Binding BatteryText}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.Warning}" />
                <Setter TargetName="Pct" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Template.PairedItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,10" Margin="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="20" Margin="2,0,14,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
