<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:c="clr-namespace:BlueDock.Controls">

    <!-- ============ Theme: Liquid Glass (Acrylic, dark) ============ -->

    <sys:String x:Key="Theme.Backdrop">Acrylic</sys:String>
    <FontFamily x:Key="Font.Main">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Used on Windows 10 / builds without system backdrops -->
    <Thickness x:Key="Thickness.WindowPadding">16,16,16,16</Thickness>
    <Thickness x:Key="Thickness.SectionHeader">4,14,0,8</Thickness>

    <CornerRadius x:Key="Radius.Badge">12</CornerRadius>

    <CornerRadius x:Key="Radius.IconButton">20</CornerRadius>
    <CornerRadius x:Key="Radius.Button">22</CornerRadius>
    <CornerRadius x:Key="Radius.Control">14</CornerRadius>
    <CornerRadius x:Key="Radius.Card">18</CornerRadius>

    <ItemsPanelTemplate x:Key="Panel.Connected"><StackPanel /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Panel.Paired"><UniformGrid Columns="2" Margin="-4,0" /></ItemsPanelTemplate>

    <DataTemplate x:Key="Template.ConnectedItem">
        <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                CornerRadius="18" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40" Margin="0,0,12,0">
                    <Ellipse Fill="{DynamicResource Brush.IconCircle}" />
                    <c:TablerIcon Data="{Binding Icon}" IconSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                            Visibility="{Binding HasBattery, Converter={x:Static c:Conv.BoolToVis}}">
                    <Grid Width="28" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Brush.BatteryTrack}" CornerRadius="4" />
                        <Border x:Name="Fill" Background="{DynamicResource Brush.BatteryFill}" CornerRadius="4" HorizontalAlignment="Left"
                                Width="{Binding BatteryValue, Converter={x:Static c:Conv.PercentToWidth}, ConverterParameter=28}" />
                    </Grid>
                    <TextBlock x:Name="Pct" Text="{Binding BatteryText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text}" />
                </StackPanel>
                <Button Grid.Column="3" Style="{DynamicResource Style.DeviceButton}" Margin="10,0,0,0"
                        VerticalAlignment="Center" Content="{Binding ActionText}"
                        Command="{Binding ToggleConnectionCommand}"
                        Visibility="{Binding CanToggle, Converter={x:Static c:Conv.BoolToVis}}"
                        ToolTip="Verbinding met dit apparaat verbreken"
                        AutomationProperties.Name="Verbinding verbreken" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.Warning}" />
                <Setter TargetName="Pct" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Template.PairedItem">
        <Button Style="{DynamicResource Style.CardButton}" Command="{Binding ToggleConnectionCommand}"
                ToolTip="Klik om te verbinden" AutomationProperties.Name="Verbinden">
    <Border x:Name="Bd" Background="{DynamicResource Brush.Tile}" BorderBrush="{DynamicResource Brush.TileBorder}" BorderThickness="1"
                    CornerRadius="16" Padding="12" Margin="4,0,4,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:TablerIcon Data="{Binding Icon}" IconSize="18" Margin="0,0,10,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Button>
        <DataTemplate.Triggers>
            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>