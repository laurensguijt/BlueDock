<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ Tiles palette: Dark ============
         Colours only. The structure of this theme (templates, radii, spacing) lives in
         Tiles.xaml; ThemeService merges a palette and a structure together. Both palettes
         of a theme must define exactly the same keys.

         The connected tile keeps the vivid accent fill in both modes, so everything drawn on
         top of it stays white; only the surrounding surfaces go dark. -->

    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#FF10131E" />
    <SolidColorBrush x:Key="Brush.WindowFallback" Color="#FF10131E" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FFF1F3FA" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF959DB8" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF4669F5" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFFD591" />
    <SolidColorBrush x:Key="Brush.Link" Color="#FF8FA6FF" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#FF262B3D" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#FF1E2434" />
    <SolidColorBrush x:Key="Brush.Badge" Color="#FF1C2240" />
    <SolidColorBrush x:Key="Brush.BadgeForeground" Color="#FF8FA6FF" />
    <SolidColorBrush x:Key="Brush.IconButton" Color="#FF191D2B" />
    <SolidColorBrush x:Key="Brush.IconButtonBorder" Color="#FF262B3D" />
    <SolidColorBrush x:Key="Brush.PrimaryBackground" Color="#FF4669F5" />
    <SolidColorBrush x:Key="Brush.PrimaryForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.PrimaryBorder" Color="#FF4669F5" />
    <SolidColorBrush x:Key="Brush.SwitchOff" Color="#FF333A4F" />
    <SolidColorBrush x:Key="Brush.SwitchBorder" Color="#FF333A4F" />
    <SolidColorBrush x:Key="Brush.SwitchThumbOff" Color="#FFF1F3FA" />
    <SolidColorBrush x:Key="Brush.SwitchOn" Color="#FF4669F5" />
    <SolidColorBrush x:Key="Brush.SwitchThumbOn" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.ControlBackground" Color="#FF161A27" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#FF262B3D" />
    <SolidColorBrush x:Key="Brush.PopupBackground" Color="#FF191D2B" />
    <SolidColorBrush x:Key="Brush.PopupText" Color="#FFF1F3FA" />
    <SolidColorBrush x:Key="Brush.PopupSelected" Color="#FF232B48" />
    <SolidColorBrush x:Key="Brush.PopupHover" Color="#FF212636" />
    <SolidColorBrush x:Key="Brush.SettingsCard" Color="#FF161A27" />
    <SolidColorBrush x:Key="Brush.SettingsCardBorder" Color="#FF262B3D" />
    <SolidColorBrush x:Key="Brush.Tile" Color="#FF161A27" />
    <SolidColorBrush x:Key="Brush.TileBorder" Color="#FF262B3D" />
    <SolidColorBrush x:Key="Brush.DeviceButton" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Brush.DeviceButtonBorder" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="Brush.DeviceButtonForeground" Color="#FFFFFFFF" />

</ResourceDictionary>
