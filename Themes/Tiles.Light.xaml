<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ Tiles palette: Light ============
         Colours only. The structure of this theme (templates, radii, spacing) lives in
         Tiles.xaml; ThemeService merges a palette and a structure together. Both palettes
         of a theme must define exactly the same keys. -->

    <sys:Boolean x:Key="Theme.IsDark">False</sys:Boolean>
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#FFF6F7FB" />
    <SolidColorBrush x:Key="Brush.WindowFallback" Color="#FFF6F7FB" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FF161A2B" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF5B6178" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF2F54EB" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFFD591" />
    <SolidColorBrush x:Key="Brush.Link" Color="#FF2F54EB" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#FFE6E8F0" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#FFEEF1FF" />
    <SolidColorBrush x:Key="Brush.Badge" Color="#FFEEF1FF" />
    <SolidColorBrush x:Key="Brush.BadgeForeground" Color="#FF2F54EB" />
    <SolidColorBrush x:Key="Brush.IconButton" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.IconButtonBorder" Color="#FFE6E8F0" />
    <SolidColorBrush x:Key="Brush.PrimaryBackground" Color="#FF2F54EB" />
    <SolidColorBrush x:Key="Brush.PrimaryForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.PrimaryBorder" Color="#FF2F54EB" />
    <SolidColorBrush x:Key="Brush.SwitchOff" Color="#FFDDE1EC" />
    <SolidColorBrush x:Key="Brush.SwitchBorder" Color="#FFDDE1EC" />
    <SolidColorBrush x:Key="Brush.SwitchThumbOff" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.SwitchOn" Color="#FF2F54EB" />
    <SolidColorBrush x:Key="Brush.SwitchThumbOn" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.ControlBackground" Color="#FFF6F7FB" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#FFE6E8F0" />
    <SolidColorBrush x:Key="Brush.PopupBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.PopupText" Color="#FF161A2B" />
    <SolidColorBrush x:Key="Brush.PopupSelected" Color="#FFEEF1FF" />
    <SolidColorBrush x:Key="Brush.PopupHover" Color="#FFF3F4F8" />
    <SolidColorBrush x:Key="Brush.SettingsCard" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.SettingsCardBorder" Color="#FFE6E8F0" />
    <SolidColorBrush x:Key="Brush.Tile" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.TileBorder" Color="#FFE6E8F0" />
    <SolidColorBrush x:Key="Brush.DeviceButton" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Brush.DeviceButtonBorder" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="Brush.DeviceButtonForeground" Color="#FFFFFFFF" />

</ResourceDictionary>
