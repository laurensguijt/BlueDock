<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:c="clr-namespace:BlueDock.Controls">

    <!-- ============ Theme: Soft Tiles (solid, light) ============ -->

    <sys:String x:Key="Theme.Backdrop">None</sys:String>
    <FontFamily x:Key="Font.Main">Segoe UI Variable Display, Segoe UI</FontFamily>

    <Thickness x:Key="Thickness.WindowPadding">15,16,15,15</Thickness>
    <Thickness x:Key="Thickness.SectionHeader">5,14,0,6</Thickness>

    <CornerRadius x:Key="Radius.Badge">12</CornerRadius>

    <CornerRadius x:Key="Radius.IconButton">14</CornerRadius>
    <CornerRadius x:Key="Radius.Button">16</CornerRadius>
    <CornerRadius x:Key="Radius.Control">12</CornerRadius>
    <CornerRadius x:Key="Radius.Card">16</CornerRadius>

    <ItemsPanelTemplate x:Key="Panel.Connected"><UniformGrid Columns="2" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Panel.Paired"><UniformGrid Columns="2" /></ItemsPanelTemplate>

    <DataTemplate x:Key="Template.ConnectedItem">
        <Border Background="{DynamicResource Brush.Accent}" CornerRadius="18" Padding="14" Margin="5" Height="140">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <c:TablerIcon Data="{Binding Icon}" IconSize="22"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{DynamicResource Brush.OnAccent}" />
                <Grid Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Visibility="{Binding HasBattery, Converter={x:Static c:Conv.BoolToVis}}">
                    <c:BatteryRing x:Name="Ring" Value="{Binding BatteryValue}" Thickness="3" Stroke="{DynamicResource Brush.OnAccent}" />
                    <TextBlock Text="{Binding Battery}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.OnAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnAccent}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#E6FFFFFF" />
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{DynamicResource Style.DeviceButton}"
                            Content="{Binding ActionText}"
                            Command="{Binding ToggleConnectionCommand}"
                            Visibility="{Binding CanToggle, Converter={x:Static c:Conv.BoolToVis}}"
                            ToolTip="Verbinding met dit apparaat verbreken"
                            AutomationProperties.Name="Verbinding verbreken" />
                    <Button x:Name="OutputBtn" Style="{DynamicResource Style.CardIconButton}" Margin="6,0,0,0"
                            Content="{DynamicResource Icon.Volume}"
                            Command="{Binding UseAsOutputCommand}"
                            Visibility="{Binding CanUseAsOutput, Converter={x:Static c:Conv.BoolToVis}}"
                            ToolTip="Geluid naar dit apparaat sturen"
                            AutomationProperties.Name="Geluid naar dit apparaat sturen" />
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsAudioOutput}" Value="True">
                <Setter TargetName="OutputBtn" Property="Background" Value="{DynamicResource Brush.OnAccent}" />
                <Setter TargetName="OutputBtn" Property="BorderBrush" Value="{DynamicResource Brush.OnAccent}" />
                <Setter TargetName="OutputBtn" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                <Setter TargetName="OutputBtn" Property="ToolTip" Value="Het geluid gaat nu hierheen" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Warning}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Template.PairedItem">
        <Button Style="{DynamicResource Style.CardButton}" Command="{Binding ToggleConnectionCommand}"
                ToolTip="Klik om te verbinden" AutomationProperties.Name="Verbinden">
    <Border x:Name="Bd" Background="{DynamicResource Brush.Tile}" BorderBrush="{DynamicResource Brush.TileBorder}" BorderThickness="1"
                    CornerRadius="18" Padding="14" Margin="5" Height="140">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <c:TablerIcon Data="{Binding Icon}" IconSize="22"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Button>
        <DataTemplate.Triggers>
            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>