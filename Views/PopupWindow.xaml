<Window x:Class="BlueDock.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BlueDock.Controls"
        Title="BlueDock"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root"
            Padding="{DynamicResource Thickness.WindowPadding}"
            TextElement.FontFamily="{DynamicResource Font.Main}"
            TextElement.Foreground="{DynamicResource Brush.Text}">
        <Grid>

            <!-- ==================== MAIN PANEL ==================== -->
            <DockPanel Visibility="{Binding IsSettingsOpen, Converter={x:Static c:Conv.InverseBoolToVis}}">

                <!-- Header -->
                <Grid DockPanel.Dock="Top" Margin="2,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="{DynamicResource Brush.Badge}" CornerRadius="{DynamicResource Radius.Badge}">
                        <TextBlock Text="&#xE702;" FontFamily="{DynamicResource IconFont}" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.BadgeForeground}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="BlueDock" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource Style.Switch}" Margin="0,0,6,0"
                              IsChecked="{Binding IsRadioOn, Mode=TwoWay}"
                              Visibility="{Binding IsRadioAvailable, Converter={x:Static c:Conv.BoolToVis}}"
                              ToolTip="Bluetooth aan/uit" AutomationProperties.Name="Bluetooth aan of uit" />
                    <Button Grid.Column="3" Style="{StaticResource Style.IconButton}" Content="&#xE713;"
                            Command="{Binding OpenSettingsCommand}" ToolTip="Instellingen"
                            AutomationProperties.Name="Instellingen" />
                </Grid>

                <!-- Footer -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource Style.PrimaryButton}" Margin="0,12,0,0"
                        Content="Apparaat toevoegen" Command="{Binding AddDeviceCommand}" />

                <!-- Device lists -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480" Focusable="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Style.SectionHeader}" Text="Verbonden"
                                   Visibility="{Binding HasConnected, Converter={x:Static c:Conv.BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Connected}" Focusable="False"
                                      ItemTemplate="{DynamicResource Template.ConnectedItem}"
                                      ItemsPanel="{DynamicResource Panel.Connected}" />

                        <TextBlock Style="{StaticResource Style.SectionHeader}" Text="Gekoppeld"
                                   Visibility="{Binding HasPaired, Converter={x:Static c:Conv.BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Paired}" Focusable="False"
                                      ItemTemplate="{DynamicResource Template.PairedItem}"
                                      ItemsPanel="{DynamicResource Panel.Paired}" />

                        <TextBlock Margin="6,28,6,20" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Visibility="{Binding IsEmpty, Converter={x:Static c:Conv.BoolToVis}}"
                                   Text="Nog geen gekoppelde Bluetooth-apparaten. Kies 'Apparaat toevoegen' om er een te koppelen." />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ==================== SETTINGS ==================== -->
            <StackPanel Visibility="{Binding IsSettingsOpen, Converter={x:Static c:Conv.BoolToVis}}">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Style.IconButton}" Content="&#xE72B;"
                            Command="{Binding CloseSettingsCommand}" ToolTip="Terug" AutomationProperties.Name="Terug" />
                    <TextBlock Grid.Column="1" Text="Instellingen" FontSize="16" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Style="{StaticResource Style.SectionHeader}" Text="Uiterlijk" />
                <Border Style="{StaticResource Style.SettingsCard}">
                    <StackPanel Margin="0,10,0,12">
                        <TextBlock Text="Thema" FontSize="14" Margin="0,0,0,6" />
                        <ComboBox Style="{StaticResource Style.ComboBox}"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                                  AutomationProperties.Name="Thema">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Style.SectionHeader}" Text="Meldingen" />
                <Border Style="{StaticResource Style.SettingsCard}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Style.Switch}" Content="Bij verbinden"
                                  IsChecked="{Binding NotifyOnConnect, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource Style.Switch}" Content="Bij verbreken"
                                  IsChecked="{Binding NotifyOnDisconnect, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource Style.Switch}" Content="Bij lage accu"
                                  IsChecked="{Binding NotifyOnLowBattery, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Style.SectionHeader}" Text="Algemeen" />
                <Border Style="{StaticResource Style.SettingsCard}">
                    <CheckBox Style="{StaticResource Style.Switch}" Content="Starten met Windows"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                </Border>

                <Button Style="{StaticResource Style.LinkButton}" Content="Bluetooth-instellingen van Windows openen"
                        Command="{Binding OpenWindowsSettingsCommand}" Margin="4,0,0,0" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Version}" FontSize="11" Margin="4,2,0,0" Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
