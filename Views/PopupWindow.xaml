<Window x:Class="BlueDock.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BlueDock.Controls"
        Title="BlueDock"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root"
            Padding="{DynamicResource Thickness.WindowPadding}"
            TextElement.FontFamily="{DynamicResource Font.Main}"
            TextElement.Foreground="{DynamicResource Brush.Text}">
        <Grid>

            <!-- ==================== MAIN PANEL ==================== -->
            <DockPanel Visibility="{Binding IsSettingsOpen, Converter={x:Static c:Conv.InverseBoolToVis}}">

                <!-- Header -->
                <Grid DockPanel.Dock="Top" Margin="2,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="{DynamicResource Brush.Badge}" CornerRadius="{DynamicResource Radius.Badge}">
                        <c:TablerIcon Data="{DynamicResource Icon.Bluetooth}" IconSize="20"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{DynamicResource Brush.BadgeForeground}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="BlueDock" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource Style.Switch}" Margin="0,0,6,0"
                              IsChecked="{Binding IsRadioOn, Mode=TwoWay}"
                              Visibility="{Binding IsRadioAvailable, Converter={x:Static c:Conv.BoolToVis}}"
                              ToolTip="Bluetooth on/off" AutomationProperties.Name="Bluetooth on or off" />
                    <Button Grid.Column="3" Style="{StaticResource Style.IconButton}" Content="{DynamicResource Icon.Settings}"
                            Command="{Binding OpenSettingsCommand}" ToolTip="Settings"
                            AutomationProperties.Name="Settings" />
                </Grid>

                <!-- Footer -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource Style.PrimaryButton}" Margin="0,12,0,0"
                        Content="Add a device" Command="{Binding AddDeviceCommand}" />

                <!-- Only here when a newer release exists; docked above the footer button -->
                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12,8"
                        Background="{DynamicResource Brush.SettingsCard}"
                        BorderBrush="{DynamicResource Brush.SettingsCardBorder}" BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Card}"
                        Visibility="{Binding IsUpdateAvailable, Converter={x:Static c:Conv.BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpdateTitle}" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UpdateStatus}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{DynamicResource Style.DeviceButton}" Margin="10,0,0,0"
                                VerticalAlignment="Center" Content="{Binding UpdateActionText}"
                                Command="{Binding InstallUpdateCommand}"
                                AutomationProperties.Name="Install the new version" />
                    </Grid>
                </Border>

                <!-- Device lists -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480" Focusable="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Style.SectionHeader}" Text="Connected"
                                   Visibility="{Binding HasConnected, Converter={x:Static c:Conv.BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Connected}" Focusable="False"
                                      ItemTemplate="{DynamicResource Template.ConnectedItem}"
                                      ItemsPanel="{DynamicResource Panel.Connected}" />

                        <TextBlock Style="{StaticResource Style.SectionHeader}" Text="Paired"
                                   Visibility="{Binding HasPaired, Converter={x:Static c:Conv.BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Paired}" Focusable="False"
                                      ItemTemplate="{DynamicResource Template.PairedItem}"
                                      ItemsPanel="{DynamicResource Panel.Paired}" />

                        <TextBlock Margin="6,28,6,20" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Visibility="{Binding IsEmpty, Converter={x:Static c:Conv.BoolToVis}}"
                                   Text="No paired Bluetooth devices yet. Choose 'Add a device' to pair one." />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ==================== SETTINGS ==================== -->
            <StackPanel Visibility="{Binding IsSettingsOpen, Converter={x:Static c:Conv.BoolToVis}}">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Style.IconButton}" Content="{DynamicResource Icon.Back}"
                            Command="{Binding CloseSettingsCommand}" ToolTip="Back" AutomationProperties.Name="Back" />
                    <TextBlock Grid.Column="1" Text="Settings" FontSize="16" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Style="{StaticResource Style.SectionHeader}" Text="Appearance" />
                <Border Style="{StaticResource Style.SettingsCard}">
                    <StackPanel Margin="0,10,0,12">
                        <TextBlock Text="Theme" FontSize="14" Margin="0,0,0,6" />
                        <ComboBox Style="{StaticResource Style.ComboBox}"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                                  AutomationProperties.Name="Theme">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Mode" FontSize="14" Margin="0,14,0,6" />
                        <Border Background="{DynamicResource Brush.ControlBackground}"
                                BorderBrush="{DynamicResource Brush.ControlBorder}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="2">
                            <UniformGrid Columns="3">
                                <RadioButton Style="{StaticResource Style.Segment}" Content="Light"
                                             IsChecked="{Binding ThemeMode, Mode=TwoWay, Converter={x:Static c:Conv.EnumToBool}, ConverterParameter=Light}"
                                             AutomationProperties.Name="Light mode" />
                                <RadioButton Style="{StaticResource Style.Segment}" Content="Dark"
                                             IsChecked="{Binding ThemeMode, Mode=TwoWay, Converter={x:Static c:Conv.EnumToBool}, ConverterParameter=Dark}"
                                             AutomationProperties.Name="Dark mode" />
                                <RadioButton Style="{StaticResource Style.Segment}" Content="Automatic"
                                             IsChecked="{Binding ThemeMode, Mode=TwoWay, Converter={x:Static c:Conv.EnumToBool}, ConverterParameter=Auto}"
                                             ToolTip="Follows the Windows colour setting"
                                             AutomationProperties.Name="Automatic, follows Windows" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Style.SectionHeader}" Text="Notifications" />
                <Border Style="{StaticResource Style.SettingsCard}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Style.Switch}" Content="On connect"
                                  IsChecked="{Binding NotifyOnConnect, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource Style.Switch}" Content="On disconnect"
                                  IsChecked="{Binding NotifyOnDisconnect, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource Style.Switch}" Content="On low battery"
                                  IsChecked="{Binding NotifyOnLowBattery, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Style.SectionHeader}" Text="Battery" />
                <Border Style="{StaticResource Style.SettingsCard}">
                    <StackPanel Margin="0,10,0,12">
                        <TextBlock Text="Warn below" FontSize="14" Margin="0,0,0,6" />
                        <ComboBox Style="{StaticResource Style.ComboBox}"
                                  ItemsSource="{Binding LowBatteryOptions}"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding LowBatteryThreshold, Mode=TwoWay}"
                                  AutomationProperties.Name="Warn below this battery level">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Refresh battery level" FontSize="14" Margin="0,14,0,6" />
                        <ComboBox Style="{StaticResource Style.ComboBox}"
                                  ItemsSource="{Binding BatteryRefreshOptions}"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding BatteryRefreshSeconds, Mode=TwoWay}"
                                  AutomationProperties.Name="How often the battery level is refreshed">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Style.SectionHeader}" Text="General" />
                <Border Style="{StaticResource Style.SettingsCard}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Style.Switch}" Content="Start with Windows"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource Style.Switch}" Content="Check for updates"
                                  IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"
                                  ToolTip="Checks GitHub for a newer version at startup" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource Style.LinkButton}" Content="Open Windows Bluetooth settings"
                        Command="{Binding OpenWindowsSettingsCommand}" Margin="4,0,0,0" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Version}" FontSize="11" Margin="4,2,0,0" Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
